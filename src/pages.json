{
	"easycom": {
		"^u-(.*)": "uview-ui/components/u-$1/u-$1.vue"
	},
	"pages": [
		{
			"path": "pages/index/index",
			"meta": {
				"auth": true
			},
			"style": {
				"enablePullDownRefresh": true,
				"navigationBarTitleText": "首页"
			}
		},
		{
			"path": "pages/cart/cart",
			"meta": {
				"auth": true
			},
			"style": {
				"navigationBarTitleText": "购物车"
			}
		},
		{
			"path": "pages/my/my",
			"meta": {
				"auth": true
			},
			"style": {
				"navigationBarTitleText": "我的"
			}
		},
		{
			"path": "pages/payResult/payResult",
			"meta": {
				"auth": true
			},
			"style": {
				"navigationBarTitleText": "支付结果"
			}
		},
		{
			"path": "pages/downLoadResult/downLoadResult",
			"meta": {
				"auth": true
			},
			"style": {
				"navigationBarTitleText": "下载结果"
			}
		},
		{
			"path": "pages/downLoadFile/downLoadFile",
			"meta": {
				"auth": true
			},
			"style": {
				"navigationBarTitleText": "下载"
			}
		},
		{
			"path": "pages/chooseSkiList/chooseSkiList",
			"meta": {
				"auth": true
			},
			"style": {
				"navigationBarTitleText": "选择滑雪场"
			}
		},
		{
			"path": "pages/timePhoto/timePhoto",
			"meta": {
				"auth": true
			},
			"style": {
				"navigationBarTitleText": "照片墙"
			}
		},
		{
			"path": "pages/confirmOrder/confirmOrder",
			"meta": {
				"auth": true
			},
			"style": {
				"navigationBarTitleText": "确认订单页"
			}
		},
		{
			"path": "pages/demo/demo",
			"meta": {
				"auth": true
			},
			"style": {
				"navigationBarTitleText": "测试"
			}
		},
		{
			"path": "pages/demo/list2",
			"meta": {
				"auth": true
			},
			"style": {
				"navigationBarTitleText": "测试列表"
			}
		},
		{
			"path": "pages/demo/list3",
			"meta": {
				"auth": true
			},
			"style": {
				"navigationBarTitleText": "测试列表"
			}
		},
		{
			"path": "pages/jump/jump",
			"meta": {
				"auth": true
			},
			"style": {
				"navigationBarTitleText": "测试"
			}
		},
		{
			"path": "pages/login/login",
			"meta": {
				"auth": false
			},
			"style": {
				"navigationBarTitleText": "登录页"
			}
		}
	],
	"globalStyle": {
		"navigationStyle": "custom",
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"condition": { //模式配置，仅开发期间生效
		"current": 0, //当前激活的模式（list 的索引项）
		"list": [
			{
				"name": "首页", //模式名称
				"path": "pages/index/index" //启动页面，必选
			},
			{
				"name": "登录页", //模式名称
				"path": "pages/login/login" //启动页面，必选
			},
			{
				"name": "选择滑雪场", //模式名称
				"path": "pages/chooseSkiList/chooseSkiList" //启动页面，必选
			},
			{
				"name": "选择时间照片", //模式名称
				"path": "pages/timePhoto/timePhoto", //启动页面，必选
				"query": "timeStr=10-22&skid=1"

			},
			{
				"name": "支付结果页", //模式名称
				"path": "pages/payResult/payResult" //启动页面，必选
			},
			{
				"name": "我的", //模式名称
				"path": "pages/my/my" //启动页面，必选
			},

			{
				"name": "下载", //模式名称
				"path": "pages/downLoadFile/downLoadFile" //启动页面，必选
			},
			{
				"name": "确认订单页", //模式名称
				"path": "pages/confirmOrder/confirmOrder" //启动页面，必选
			},
			{
				"name": "购物车", //模式名称
				"path": "pages/cart/cart" //启动页面，必选
			},
			{
				"name": "瀑布流", //模式名称
				"path": "pages/demo/list3" //启动页面，必选
			},
			{
				"name": "demo", //模式名称
				"path": "pages/demo/demo" //启动页面，必选
			}
		]
	}
}
