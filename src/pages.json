		"backgroundColor": "#fff", //背景颜色
		"list": [
			{
				"text": "首页",
				"pagePath": "pages/index/index", //路径
				"iconPath": "/static/images/backhei.png", // 当前图片的颜色
				"selectedIconPath": "/static/images/backhei.png" // 选中图片的颜色
			},
			{
				"text": "我的的",
				"pagePath": "pages/demo/demo",
				"iconPath": "/static/images/backhei.png",
